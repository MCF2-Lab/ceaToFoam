FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101353;


boundaryField
{
    freestream
    {
        type            waveTransmissive;
        gamma           1.14;
        fieldInf        101353;
        lInf            10;
        value           uniform 101353;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 3.44738e+06;
    }
    walls
    {
        type            zeroGradient;
    }
    bottomEmptyFaces
    {
        type            empty;
    }
    topEmptyFaces
    {
        type            empty;
    }
}


