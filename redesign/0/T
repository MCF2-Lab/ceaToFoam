FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 288.19;
boundaryField
{
    outlet
    {
        type            waveTransmissive;
        gamma           1.1375;
        fieldInf        288.19;
        lInf            10;
        value           uniform 288.19;
    }
    inlet
    {
        type         totalTemperature;
	    gamma        1.1375;
        T0           uniform 3538.04;
	    value	     uniform 3538.04;
    }
    wall
    {
        type            zeroGradient;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
}


