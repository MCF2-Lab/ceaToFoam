FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    object    controlDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sonicFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.1;

deltaT          1e-06;

writeControl    runTime;

writeInterval   1e-5;

writeFormat     ascii;

writePrecision 6;

writeCompression off;

timeFormat	general;

timePrecision 	6;

runTimeModifiable true;

// ************************************************************************* //
