FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (119.81274387197959 0 0);

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    freestream
    {
        type            zeroGradient;
    }

    walls
    {
        type            noSlip;
    }

    bottomEmptyFaces
    {
        type            empty;
    }

    topEmptyFaces
    {
        type            empty;
    }
}


